# =========================================================================
# FMC + ISE IoT Security Dashboard - environment configuration
# Copy this file to `.env` and fill in your sandbox / lab credentials.
# =========================================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DASHBOARD_CACHE_SECONDS=300

# =========================================================================
# Cisco ISE  (ERS API on port 9060 + MnT session API)
# HOST is hostname/IP only - no https:// and no port.
# The ERS account must have the "ERS Admin" / "ERS Operator" role enabled
# in ISE (Administration > System > Settings > API Settings).
# =========================================================================
ISE_ENABLED=True
ISE_HOST=
ISE_ERS_PORT=9060
ISE_USERNAME=
ISE_PASSWORD=
ISE_VERIFY_TLS=False
ISE_TIMEOUT=30
# Endpoints are listed cheaply, but per-endpoint attribute detail needs one
# GET each. Cap how many we enrich so the sandbox isn't overloaded.
ISE_DETAIL_LIMIT=50
ISE_PAGE_SIZE=100
ISE_MAX_PAGES=20

# =========================================================================
# Cisco FMC  (REST config API - token auth)
# HOST is hostname/IP only. DOMAIN_UUID can be left blank to auto-pick the
# Global domain returned by the auth call.
# =========================================================================
FMC_ENABLED=True
FMC_HOST=
FMC_PORT=443
FMC_USERNAME=
FMC_PASSWORD=
FMC_VERIFY_TLS=False
FMC_TIMEOUT=30
FMC_DOMAIN_UUID=
FMC_PAGE_LIMIT=100
FMC_MAX_PAGES=20
