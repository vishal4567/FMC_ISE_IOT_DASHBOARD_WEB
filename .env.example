# =========================================================================
# FMC + ISE IoT Security Dashboard - environment configuration
# Copy this file to `.env` and fill in your sandbox / lab credentials.
# =========================================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DASHBOARD_CACHE_SECONDS=300

# =========================================================================
# Cisco ISE  (ERS API on port 9060 + MnT session API)
# HOST is hostname/IP only - no https:// and no port.
# The ERS account must have the "ERS Admin" / "ERS Operator" role enabled
# in ISE (Administration > System > Settings > API Settings).
# =========================================================================
ISE_ENABLED=True
ISE_HOST=
ISE_ERS_PORT=9060
ISE_USERNAME=
ISE_PASSWORD=
ISE_VERIFY_TLS=False
ISE_TIMEOUT=30
ISE_PAGE_SIZE=100
ISE_MAX_PAGES=200
# ---- IoT scoping: import ONLY these profiles/logical-profiles ----
# Logical profiles (preferred - one filtered call each). Blank to use ISE_IOT_PROFILES.
ISE_IOT_LOGICAL_PROFILES=Wipro_CCTV,Wipro-Access-Control,Wipro-BMS
# Profiling-policy names (used when no logical profiles set). Defaults to the
# built-in IoT list in settings; override with a comma-separated list.
#ISE_IOT_PROFILES=Axis-Device,Mobotix-Camera,Bosch_Security_Systems,...
# Location per endpoint: session (MnT->NAS->NAD Location) | subnet | off
ISE_LOCATION_METHOD=session
# For LOCATION_METHOD=subnet: site=CIDR pairs
#ISE_SITE_SUBNETS=Mumbai=10.59.0.0/16;PUNE=10.22.0.0/16
ISE_SYNC_WORKERS=8

# =========================================================================
# Cisco FMC  (REST config API - token auth)
# HOST is hostname/IP only. DOMAIN_UUID can be left blank to auto-pick the
# Global domain returned by the auth call.
# =========================================================================
FMC_ENABLED=True
FMC_HOST=
FMC_PORT=443
FMC_USERNAME=
FMC_PASSWORD=
FMC_VERIFY_TLS=False
FMC_TIMEOUT=30
FMC_DOMAIN_UUID=
FMC_PAGE_LIMIT=100
FMC_MAX_PAGES=20
