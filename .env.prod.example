# =========================================================================
# Production stack config (docker compose --env-file .env.prod)
# =========================================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=dashboard.example.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://dashboard.example.com

# ---- Database (Postgres/TimescaleDB) ----
POSTGRES_DB=iotdash
POSTGRES_USER=iotdash
POSTGRES_PASSWORD=change-me-strong

# ---- Event pipeline ----
EVENT_BACKEND=db
RETENTION_THREAT_DAYS=90
RETENTION_CONNECTION_DAYS=14

# ---- Cisco ISE ----
ISE_HOST=
ISE_USERNAME=
ISE_PASSWORD=
ISE_ERS_PORT=443
ISE_VERIFY_TLS=True
# ---- IoT scoping: import ONLY these profiles (not all endpoints) ----
# Logical profiles (preferred - one filtered ISE call each). Blank to fall back
# to per-profiling-policy filtering via ISE_IOT_PROFILES.
ISE_IOT_LOGICAL_PROFILES=Wipro_CCTV,Wipro-Access-Control,Wipro-BMS
# Override the built-in IoT profiling-policy allow-list if needed:
#ISE_IOT_PROFILES=Axis-Device,Mobotix-Camera,Bosch_Security_Systems,...
# Site/location per endpoint: session (MnT->NAS->NAD Location) | subnet | off
ISE_LOCATION_METHOD=session
# For LOCATION_METHOD=subnet: site=CIDR pairs
#ISE_SITE_SUBNETS=Mumbai=10.59.0.0/16;PUNE=10.22.0.0/16
ISE_SYNC_WORKERS=8
# Confirm the filter + device-type/location sources against your ISE:
#   manage.py probe_apis            (runs the ise.iot.profile_filter probe)
#   manage.py probe_apis --mac <a-known-IoT-MAC>

# ---- Cisco FMC ----
FMC_HOST=
FMC_USERNAME=
FMC_PASSWORD=
FMC_VERIFY_TLS=True
