# =========================================================================
# Production stack config (docker compose --env-file .env.prod)
# =========================================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=dashboard.example.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://dashboard.example.com

# ---- Database (Postgres/TimescaleDB) ----
POSTGRES_DB=iotdash
POSTGRES_USER=iotdash
POSTGRES_PASSWORD=change-me-strong

# ---- Event pipeline ----
EVENT_BACKEND=db
RETENTION_THREAT_DAYS=90
RETENTION_CONNECTION_DAYS=14

# ---- Cisco ISE ----
ISE_HOST=
ISE_USERNAME=
ISE_PASSWORD=
ISE_ERS_PORT=443
ISE_VERIFY_TLS=True
# ---- IoT scoping: import ONLY these profiles (not all endpoints) ----
# Discovery via ERS: filter /endpoint by profileId, device type from
# mfcAttributes.mfcDeviceType (Open API deviceType is blank in this ISE).
ISE_USE_OPENAPI=False
ISE_ERS_ENRICH=True
# The IoT profiling-policy allow-list (defaults to the built-in 21). Override:
#ISE_IOT_PROFILES=Axis-Device,Mobotix-Camera,Bosch_Security_Systems,...
# ERS-path option: filter by logicalProfileName instead of profileId (only if
# the ERS profileId filter isn't available):
#ISE_IOT_LOGICAL_PROFILES=Wipro_CCTV,Wipro-Access-Control,Wipro-BMS
# Site/location per endpoint (IP not needed): session = MnT session -> NAS
# IP/name -> that NAD's Location group. | subnet (only if endpoint IP present) | off
ISE_LOCATION_METHOD=session
#ISE_SITE_SUBNETS=Mumbai=10.59.0.0/16;PUNE=10.22.0.0/16   # subnet method only
ISE_SYNC_WORKERS=8

# ---- ISE Data Connect (SQL over ISE DB; best for very large deployments) ----
# Read-only SQL for discovery instead of REST paging. Enable it in ISE:
#   Administration > System > Settings > Data Connect (set password, get cert).
ISE_DATACONNECT_ENABLED=False
ISE_USE_DATACONNECT=False               # use Data Connect as the sync discovery source
ISE_DATACONNECT_HOST=INBLRKOD-S5DC-ISE4.wipro.com
ISE_DATACONNECT_PORT=2484
ISE_DATACONNECT_SERVICE=cpm10
ISE_DATACONNECT_USER=dataconnect
ISE_DATACONNECT_PASSWORD=''             # single-quote it
ISE_DATACONNECT_VERIFY_TLS=False        # True + CA_CERT once you trust the ISE cert
#ISE_DATACONNECT_CA_CERT=/opt/iotdash/dataconnect.pem
# Schema mapping — set these from `manage.py probe_dataconnect` output:
#ISE_DC_ENDPOINTS_VIEW=endpoints_data
#ISE_DC_COL_MAC=mac_address
#ISE_DC_COL_PROFILE=endpoint_policy
#ISE_DC_COL_GROUP=
#ISE_DC_COL_DEVICETYPE=
#ISE_DC_COL_IP=
#ISE_DC_COL_SITE=
# Location source (site). radius_authentications is a big auth LOG (slow). Faster:
#   1) the summary view (one row per endpoint):
#ISE_DC_LOCATION_VIEW=radius_authentication_summary
#   2) or skip the RADIUS query entirely and map the endpoint IP to a site:
#ISE_DC_LOCATION_VIEW=                     # empty = no RADIUS location query
#ISE_SITE_SUBNETS=Mumbai=10.59.0.0/16;PUNE=10.22.0.0/16
# Confirm filter + device-type/location sources against your ISE first:
#   manage.py probe_apis            (runs ise.iot.profile_filter - dumps a full
#                                    Open API endpoint object)
#   manage.py probe_apis --mac <a-known-IoT-MAC>

# ---- Cisco FMC ----
FMC_HOST=
FMC_USERNAME=
FMC_PASSWORD=
FMC_VERIFY_TLS=True
