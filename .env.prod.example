# =========================================================================
# Production stack config (docker compose --env-file .env.prod)
# =========================================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=dashboard.example.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://dashboard.example.com

# ---- Database (Postgres/TimescaleDB) ----
POSTGRES_DB=iotdash
POSTGRES_USER=iotdash
POSTGRES_PASSWORD=change-me-strong

# ---- Event pipeline ----
EVENT_BACKEND=db
RETENTION_THREAT_DAYS=90
RETENTION_CONNECTION_DAYS=14

# ---- Cisco ISE ----
ISE_HOST=
ISE_USERNAME=
ISE_PASSWORD=
ISE_VERIFY_TLS=True

# ---- Cisco FMC ----
FMC_HOST=
FMC_USERNAME=
FMC_PASSWORD=
FMC_VERIFY_TLS=True
