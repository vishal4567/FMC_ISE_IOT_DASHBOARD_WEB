# =========================================================================
# Production stack config (docker compose --env-file .env.prod)
# =========================================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=dashboard.example.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://dashboard.example.com

# ---- Database (Postgres/TimescaleDB) ----
POSTGRES_DB=iotdash
POSTGRES_USER=iotdash
POSTGRES_PASSWORD=change-me-strong

# ---- Event pipeline ----
EVENT_BACKEND=db
RETENTION_THREAT_DAYS=90
RETENTION_CONNECTION_DAYS=14

# ---- Cisco ISE ----
ISE_HOST=
ISE_USERNAME=
ISE_PASSWORD=
ISE_ERS_PORT=443
ISE_VERIFY_TLS=True
# ---- IoT scoping: import ONLY these profiles (not all endpoints) ----
# Discovery via ERS: filter /endpoint by profileId, device type from
# mfcAttributes.mfcDeviceType (Open API deviceType is blank in this ISE).
ISE_USE_OPENAPI=False
ISE_ERS_ENRICH=True
# The IoT profiling-policy allow-list (defaults to the built-in 21). Override:
#ISE_IOT_PROFILES=Axis-Device,Mobotix-Camera,Bosch_Security_Systems,...
# ERS-path option: filter by logicalProfileName instead of profileId (only if
# the ERS profileId filter isn't available):
#ISE_IOT_LOGICAL_PROFILES=Wipro_CCTV,Wipro-Access-Control,Wipro-BMS
# Site/location per endpoint (IP not needed): session = MnT session -> NAS
# IP/name -> that NAD's Location group. | subnet (only if endpoint IP present) | off
ISE_LOCATION_METHOD=session
#ISE_SITE_SUBNETS=Mumbai=10.59.0.0/16;PUNE=10.22.0.0/16   # subnet method only
ISE_SYNC_WORKERS=8
# Confirm filter + device-type/location sources against your ISE first:
#   manage.py probe_apis            (runs ise.iot.profile_filter - dumps a full
#                                    Open API endpoint object)
#   manage.py probe_apis --mac <a-known-IoT-MAC>

# ---- Cisco FMC ----
FMC_HOST=
FMC_USERNAME=
FMC_PASSWORD=
FMC_VERIFY_TLS=True
