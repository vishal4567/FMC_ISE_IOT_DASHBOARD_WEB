[Unit]
Description=IoT Security Dashboard - eStreamer ingester (eNcore -> DB)
After=network-online.target postgresql.service iotdash-web.service
Wants=network-online.target

# Requires Cisco eNcore installed at /opt/eStreamer-eNcore and configured with
# the FMC pkcs12 client cert (System > Integration > eStreamer > Create Client).
[Service]
Type=simple
User=iotdash
Group=iotdash
# eNcore uses RELATIVE paths internally (./estreamer/..., default.conf), so it
# must run from its own dir. cd there for encore; use absolute paths for the
# ingester (manage.py finds `config` via its own dir regardless of cwd).
WorkingDirectory=/opt/eStreamer-eNcore
EnvironmentFile=/opt/iotdash/.env.prod
ExecStart=/bin/bash -lc 'cd /opt/eStreamer-eNcore && bash encore.sh foreground | /opt/iotdash/.venv/bin/python /opt/iotdash/manage.py estreamer_ingest --source stdin'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
