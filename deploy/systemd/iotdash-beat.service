[Unit]
Description=IoT Security Dashboard - Celery beat (scheduler)
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=iotdash
Group=iotdash
WorkingDirectory=/opt/iotdash
EnvironmentFile=/opt/iotdash/.env.prod
ExecStart=/opt/iotdash/.venv/bin/celery -A config beat -l info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
